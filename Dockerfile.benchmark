# This image is deployed only to the separate RustyAuth Benchmarks project. It
# is not referenced by railway.template.json or any supported installation.
FROM grafana/k6:1.3.0@sha256:3ddc8b1a33a2c3d8edc6e99b6a762ae36cba08788463458f5e6a7703e14eb77d AS k6

FROM rust:1.97.1-slim-bookworm@sha256:96c0af8cf054fd006435089f0076729716784ec9be485bd655de59c55df105ce AS build
RUN apt-get update \
  && apt-get install -y --no-install-recommends clang libssl-dev pkg-config \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY proto ./proto
# Keep the dependency graph in a reusable image layer. The benchmark helper is
# changed frequently while a release is being qualified; those source edits
# should rebuild the workspace crate, not every third-party dependency.
RUN --mount=type=cache,id=s/e0d03bd6-31ea-4575-9026-b825ffff24e2-/usr/local/cargo/registry,target=/usr/local/cargo/registry \
  --mount=type=cache,id=s/e0d03bd6-31ea-4575-9026-b825ffff24e2-/src/target,target=/src/target \
  mkdir -p src/bin \
  && printf 'fn main() {}\n' > src/bin/rustyauth-benchmark.rs \
  && touch src/lib.rs \
  && cargo build --locked --release --features benchmark-tools --bin rustyauth-benchmark \
  && rm -rf src
COPY rustyauth.example.yaml rustyauth.fleet.example.yaml ./
COPY src ./src
RUN --mount=type=cache,id=s/e0d03bd6-31ea-4575-9026-b825ffff24e2-/usr/local/cargo/registry,target=/usr/local/cargo/registry \
  --mount=type=cache,id=s/e0d03bd6-31ea-4575-9026-b825ffff24e2-/src/target,target=/src/target \
  find src -type f -exec touch {} + \
  && cargo build --locked --release --features benchmark-tools --bin rustyauth-benchmark \
  && cp /src/target/release/rustyauth-benchmark /usr/local/bin/rustyauth-benchmark

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates coreutils \
  && rm -rf /var/lib/apt/lists/*
COPY --from=k6 /usr/bin/k6 /usr/local/bin/k6
COPY --from=build /usr/local/bin/rustyauth-benchmark /usr/local/bin/rustyauth-benchmark
COPY benchmarks /opt/rustyauth/benchmarks
RUN chmod 0755 \
  /opt/rustyauth/benchmarks/run-starter-baseline.sh \
  /opt/rustyauth/benchmarks/run-enterprise-profile.sh
WORKDIR /opt/rustyauth
ENTRYPOINT []
CMD ["sleep", "infinity"]
