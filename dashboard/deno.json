{
  "tasks": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "check": "deno check src/main.tsx && deno lint src vite.config.ts && deno fmt --check src vite.config.ts deno.json index.html"
  },
  "imports": {
    "@connectrpc/connect": "npm:@connectrpc/connect@^2.1.2",
    "@rustyauth/connect-solid": "../packages/connect-solid/src/index.ts",
    "@rustyauth/protocol": "../packages/protocol/index.ts",
    "@tanstack/solid-query": "npm:@tanstack/solid-query@^5.83.0",
    "solid-icons": "npm:solid-icons@^1.1.0",
    "solid-js": "npm:solid-js@^1.9.9",
    "vite": "npm:vite@^7.1.1",
    "vite-plugin-solid": "npm:vite-plugin-solid@^2.11.8"
  },
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "strict": true
  }
}
