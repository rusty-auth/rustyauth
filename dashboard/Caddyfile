{
	admin off
	auto_https off
}

:{$PORT:8080} {
	log {
		format json
	}

	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}

	handle /healthz {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	handle /readyz {
		reverse_proxy {$RUSTYAUTH_API_UPSTREAM:http://control-plane:8080}
	}

	@auth path \
 /v1/passkeys/registration/options \
 /v1/passkeys/registration/verify \
 /v1/passkeys/authentication/options \
 /v1/passkeys/authentication/verify \
 /v1/sign-out \
 /.well-known/openid-configuration \
 /.well-known/jwks.json \
 /.well-known/passkey-auth
	handle @auth {
		reverse_proxy {$RUSTYAUTH_API_UPSTREAM:http://control-plane:8080}
	}

	@rpc path_regexp rpc ^/rustyauth\.(fleet\.v1\.FleetService|organization\.v1\.OrganizationService|identity\.v1\.IdentityService|service_accounts\.v1\.ServiceAccountService|management\.v1\.RealmManagementService)/[A-Za-z0-9]+$
	handle @rpc {
		reverse_proxy {$RUSTYAUTH_API_UPSTREAM:http://control-plane:8080}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
