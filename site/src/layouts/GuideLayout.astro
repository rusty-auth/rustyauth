---
import BaseLayout from "./BaseLayout.astro";
import { guides } from "../data/guides";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  currentPath: string;
}

const { title, description, eyebrow, heading, intro, currentPath } = Astro.props;
const currentUrl = `https://rustyauth.dev${currentPath}`;
---

<BaseLayout
  {title}
  {description}
  structuredData={{
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "RustyAuth", item: "https://rustyauth.dev/" },
      { "@type": "ListItem", position: 2, name: heading, item: currentUrl },
    ],
  }}
>
  <main class="guide-page">
    <header class="guide-hero shell">
      <p class="kicker"><span></span> {eyebrow}</p>
      <h1>{heading}</h1>
      <p>{intro}</p>
      <time datetime="2026-08-09">Updated 9 August 2026</time>
    </header>

    <div class="guide-frame shell">
      <article class="guide-content">
        <slot />
      </article>
      <aside class="guide-related" aria-label="Related developer guides">
        <p>Developer guides</p>
        {
          guides.map((guide) => (
            <a class:list={{ active: guide.href === currentPath }} href={guide.href} aria-current={guide.href === currentPath ? "page" : undefined}>
              {guide.label}<span aria-hidden="true">→</span>
            </a>
          ))
        }
        <a href="/docs">Product documentation<span aria-hidden="true">→</span></a>
        <div>
          <strong>Project status</strong>
          <span>RustyAuth 0.1.0 is a pre-release. Read the documented boundaries before production adoption.</span>
          <a href="/docs/project-status">Review status →</a>
        </div>
      </aside>
    </div>

    <section class="guide-cta shell">
      <div>
        <p class="kicker"><span></span> Try the complete boundary</p>
        <h2>Run passkey authentication locally.</h2>
      </div>
      <a class="button button-primary" href="/docs/getting-started">Start locally <span>→</span></a>
    </section>
  </main>
</BaseLayout>
