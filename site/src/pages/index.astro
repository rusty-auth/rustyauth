---
import AuthFlow3D from "../components/AuthFlow3D";
import BaseLayout from "../layouts/BaseLayout.astro";

const capabilities = [
  [
    "WebAuthn",
    "Passkeys, end to end",
    "Registration, authentication and multi-credential management with five-minute, server-side, single-use ceremonies.",
  ],
  [
    "Sessions",
    "Durable and revocable",
    "HttpOnly sessions with idle and absolute expiry. Raw bearer values never become durable database records.",
  ],
  [
    "Tokens",
    "Narrow downstream trust",
    "Short-lived ES256 access tokens, public JWKS and explicit issuer, audience, tenant and authentication claims.",
  ],
  [
    "Storage",
    "Private by design",
    "One private, volume-backed SableDB instance for users, credentials, ceremonies, sessions and ordered events.",
  ],
  [
    "Operations",
    "Fails closed",
    "Automatic signing-key rotation, verified scheduled snapshots, JSON operator receipts and clean-room restore.",
  ],
  [
    "Ownership",
    "Your identity boundary",
    "No required hosted identity provider. Your application keeps authorization, entitlement and resource decisions.",
  ],
];

const threatShifts = [
  [
    "01",
    "Automated credential attacks",
    "Passkeys remove the reusable password and bind authentication to the real relying-party origin.",
    "Available now",
  ],
  [
    "02",
    "More machine access",
    "Short-lived tokens and revocable service credentials narrow the trust handed to downstream systems.",
    "Available now",
  ],
  [
    "03",
    "Autonomous authority",
    "Purpose-bound grants and constrained agent delegation are the direction—not a hidden feature claim.",
    "Product direction",
  ],
];

const solutionLinks = [
  ["SaaS", "/solutions/saas"],
  ["Gambling and gaming", "/solutions/gambling-gaming"],
  ["Banking and payments", "/solutions/banking-payments"],
  ["Financial services", "/solutions/financial-services"],
  ["Healthcare products", "/solutions/healthcare-products"],
  ["Defence and secure systems", "/solutions/defence-secure-systems"],
];
---

<BaseLayout
  title="RustyAuth — Authentication for the agentic threat era"
  description="Ship passkey-first authentication without building the identity stack yourself. Deploy RustyAuth in your cloud, customer infrastructure or disconnected environments."
>
  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="kicker"><span></span> Passkey authentication infrastructure</p>
        <h1>Authentication for the<br /><em>agentic threat era.</em></h1>
        <p class="hero-intro">
          Ship passkey-first authentication without building the identity stack yourself. Run it in your cloud,
          your customer’s infrastructure, or disconnected environments.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/docs/getting-started">Start locally <span>→</span></a>
          <a class="button button-secondary" href="/solutions">Explore solutions <span>→</span></a>
        </div>
        <p class="hero-note">0.1.0 pre-release · Apache-2.0 · Self-hosted</p>
      </div>
      <AuthFlow3D client:load />
    </section>

    <section class="manifesto">
      <div class="shell manifesto-grid">
        <p><strong>Passwords out.</strong></p>
        <p><strong>Short-lived trust.</strong></p>
        <p><strong>Customer-controlled.</strong></p>
      </div>
    </section>

    <section class="section shell" id="why-rustyauth">
      <div class="section-heading">
        <p class="kicker"><span></span> A deliberately small boundary</p>
        <h2>Security infrastructure<br />you can account for.</h2>
        <p>
          RustyAuth authenticates an identity and produces claims. Your application remains responsible for roles,
          permissions, entitlements and resource ownership.
        </p>
      </div>
      <div class="capability-grid">
        {
          capabilities.map(([eyebrow, title, body], index) => (
            <article class="capability-card">
              <div class="capability-number">0{index + 1}</div>
              <p>{eyebrow}</p>
              <h3>{title}</h3>
              <span>{body}</span>
            </article>
          ))
        }
      </div>
    </section>

    <section class="home-era-section" id="why-now">
      <div class="shell home-era-inner">
        <div class="home-era-copy">
          <p class="kicker"><span></span> Why now</p>
          <h2>Attack moves faster.<br />Trust should get narrower.</h2>
          <p>
            AI accelerates phishing and automation while software agents create more paths into valuable systems.
            RustyAuth starts by removing reusable human credentials and containing downstream access.
          </p>
        </div>
        <div class="threat-list">
          {
            threatShifts.map(([number, title, body, state]) => (
              <article>
                <span>{number}</span>
                <div><h3>{title}</h3><p>{body}</p></div>
                <strong class={state === "Available now" ? "ready" : "direction"}>{state}</strong>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section shell home-solutions-brief" id="solutions">
      <div class="section-heading">
        <p class="kicker"><span></span> Solutions</p>
        <h2>Start with SaaS.<br />Go where control matters.</h2>
        <p>
          Explore six reference scenarios—from internet-scale products to regulated and disconnected systems—on the
          dedicated Solutions page.
        </p>
      </div>
      <div class="solution-link-grid">
        {
          solutionLinks.map(([label, href], index) => (
            <a href={href}>
              <span>0{index + 1}</span>
              <strong>{label}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </section>

    <section class="quickstart-section home-quickstart">
      <div class="shell quickstart-grid">
        <div class="quickstart-copy">
          <p class="kicker light"><span></span> Fast path for product teams</p>
          <h2>Three commands.<br />One identity boundary.</h2>
          <p>
            Docker Compose starts RustyAuth on loopback and keeps SableDB private. Explore the complete
            authentication path before deciding where the service should live.
          </p>
          <a class="text-link" href="/docs/getting-started">Read the complete quickstart <span>→</span></a>
        </div>
        <div class="terminal" aria-label="RustyAuth Docker quickstart">
          <div class="terminal-bar"><span></span><span></span><span></span><small>terminal</small></div>
          <pre><code><b>$</b> git clone https://github.com/<br />&nbsp;&nbsp;rusty-auth/rustyauth.git<br /><br /><b>$</b> cd rustyauth<br /><b>$</b> cp .env.example .env<br /><br /><b>$</b> docker compose up --build<br /><br /><i>✓ RustyAuth ready on :8081</i><br /><i>✓ SableDB private and healthy</i></code></pre>
        </div>
      </div>

      <div class="shell release-summary">
        <div>
          <p>Honest by default</p>
          <h3>Pre-release, plainly stated.</h3>
        </div>
        <div>
          <span class="ready">Available today</span>
          <p>Passkeys, revocable sessions, ES256 tokens, automatic key rotation, scheduled backups and clean-room restore.</p>
        </div>
        <div>
          <span class="planned">Before 1.0</span>
          <p>Account recovery, abuse controls, multi-writer qualification and an independent security assessment.</p>
        </div>
      </div>
    </section>

    <section class="final-cta final-cta-compact shell">
      <p class="kicker centered"><span></span> Start with the boundary</p>
      <h2>Ship passkey authentication<br />without the identity detour.</h2>
      <p class="final-cta-support">
        Add passkeys without the cost and dependency of another hosted identity platform. Run RustyAuth in
        infrastructure you control.
      </p>
      <div class="hero-actions centered-actions">
        <a class="button button-primary" href="/docs/getting-started">Start locally <span>→</span></a>
        <a class="button button-secondary" href="/solutions">Find your scenario <span>→</span></a>
      </div>
      <p class="final-release-note">
        The solution stories are illustrative—not customer case studies or compliance claims.
      </p>
    </section>
  </main>
</BaseLayout>
