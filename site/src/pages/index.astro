---
import AuthFlow3D from "../components/AuthFlow3D";
import { guides } from "../data/guides";
import BaseLayout from "../layouts/BaseLayout.astro";

const heroSlides = [
  {
    label: "Passkey-first",
    headline: "Without the identity detour.",
    body: "Add phishing-resistant passkeys without building WebAuthn ceremonies, session management, JWT signing and key rotation yourself. Deploy it wherever your trust boundary lives.",
  },
  {
    label: "Rust core",
    headline: "Built in Rust.",
    body: "A deliberately small authentication boundary built on Rust’s memory-safe foundation, with passkeys, revocable sessions and short-lived ES256 tokens included.",
  },
  {
    label: "SableDB",
    headline: "Durable on SableDB.",
    body: "A private, volume-backed SableDB key-value store keeps credentials, ceremonies and sessions close to the hot path for durable, low-latency authentication.",
  },
  {
    label: "Lean runtime",
    headline: "Fast, lean, self-hosted.",
    body: "A compact Rust runtime and private SableDB deployment keep infrastructure overhead low—without adding another per-user hosted identity bill.",
  },
];

const capabilities = [
  [
    "WebAuthn",
    "Passkeys, end to end",
    "Registration, authentication and multi-credential management with five-minute, server-side, single-use ceremonies.",
  ],
  [
    "Sessions",
    "Durable and revocable",
    "HttpOnly sessions with idle and absolute expiry. Raw bearer values never become durable database records.",
  ],
  [
    "Tokens",
    "Narrow downstream trust",
    "Short-lived ES256 access tokens, public JWKS and explicit issuer, audience, tenant and authentication claims.",
  ],
  [
    "Storage",
    "Private by design",
    "One private, volume-backed SableDB instance for users, credentials, ceremonies, sessions and ordered events.",
  ],
  [
    "Operations",
    "Fails closed",
    "Automatic signing-key rotation, verified scheduled snapshots, JSON operator receipts and clean-room restore.",
  ],
  [
    "Ownership",
    "Your identity boundary",
    "No required hosted identity provider. Your application keeps authorization, entitlement and resource decisions.",
  ],
];

const threatShifts = [
  [
    "01",
    "Automated credential attacks",
    "Passkeys remove the reusable password and bind authentication to the real relying-party origin.",
    "Available now",
  ],
  [
    "02",
    "More machine access",
    "Short-lived tokens and revocable service credentials narrow the trust handed to downstream systems.",
    "Available now",
  ],
  [
    "03",
    "Autonomous authority",
    "Purpose-bound grants and constrained agent delegation are the direction—not a hidden feature claim.",
    "Product direction",
  ],
];

const solutionLinks = [
  ["SaaS", "/solutions/saas"],
  ["Gambling and gaming", "/solutions/gambling-gaming"],
  ["Banking and payments", "/solutions/banking-payments"],
  ["Financial services", "/solutions/financial-services"],
  ["Healthcare products", "/solutions/healthcare-products"],
  ["Defence and secure systems", "/solutions/defence-secure-systems"],
];

---

<BaseLayout
  title="RustyAuth — Self-Hosted Passkey Authentication in Rust"
  description="Open-source, passkey-first authentication built in Rust. Self-host with private SableDB storage in your cloud, customer infrastructure or disconnected environments."
  structuredData={{
    "@type": "SoftwareSourceCode",
    "@id": "https://rustyauth.dev/#software",
    name: "RustyAuth",
    description: "Open-source, self-hosted passkey authentication built in Rust with private SableDB storage.",
    url: "https://rustyauth.dev/",
    codeRepository: "https://github.com/rusty-auth/rustyauth",
    programmingLanguage: "Rust",
    runtimePlatform: "Docker and Linux",
    license: "https://www.apache.org/licenses/LICENSE-2.0",
    version: "0.1.0",
  }}
>
  <main>
    <section class="hero shell">
      <div class="hero-copy" data-hero-carousel aria-roledescription="carousel" aria-label="RustyAuth product highlights">
        <p class="kicker"><span></span> Open-source authentication infrastructure for developers</p>
        <h1>Self-hosted passkey authentication.</h1>
        <div class="hero-slides" data-carousel-slides aria-live="off" aria-atomic="true">
          {
            heroSlides.map(({ headline, body }, index) => (
              <div
                class:list={["hero-slide", { "is-active": index === 0 }]}
                data-carousel-slide
                aria-hidden={index === 0 ? "false" : "true"}
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${heroSlides.length}`}
              >
                <p class="hero-value-headline">{headline}</p>
                <p class="hero-intro">{body}</p>
              </div>
            ))
          }
        </div>
        <div class="hero-carousel-controls">
          <div class="hero-rotator-tabs" role="group" aria-label="Choose a product highlight">
            {
              heroSlides.map(({ label }, index) => (
                <button
                  class:list={["hero-rotator-tab", { "is-active": index === 0 }]}
                  type="button"
                  data-carousel-tab
                  data-slide-index={index}
                  aria-pressed={index === 0 ? "true" : "false"}
                  aria-label={`Show ${label} highlight`}
                >
                  <span>0{index + 1}</span>
                  <strong>{label}</strong>
                </button>
              ))
            }
          </div>
          <button class="hero-rotator-toggle" type="button" data-carousel-toggle aria-label="Pause rotating headlines">
            <span data-carousel-toggle-icon aria-hidden="true">Ⅱ</span>
            <span class="sr-only" data-carousel-toggle-label>Pause rotating headlines</span>
          </button>
        </div>
        <div class="hero-actions">
          <a class="button button-primary" href="/docs/getting-started">Start locally <span>→</span></a>
          <a class="button button-secondary" href="/solutions">Explore solutions <span>→</span></a>
        </div>
        <p class="hero-note">0.1.0 pre-release · Apache-2.0 · Self-hosted</p>
      </div>
      <AuthFlow3D client:idle />
    </section>

    <section class="manifesto">
      <div class="shell manifesto-grid">
        <p><strong>Passwords out.</strong></p>
        <p><strong>Short-lived trust.</strong></p>
        <p><strong>Customer-controlled.</strong></p>
      </div>
    </section>

    <section class="section shell" id="why-rustyauth">
      <div class="section-heading">
        <p class="kicker"><span></span> A deliberately small boundary</p>
        <h2>Security infrastructure<br />you can account for.</h2>
        <p>
          RustyAuth authenticates an identity and produces claims. Your application remains responsible for roles,
          permissions, entitlements and resource ownership.
        </p>
      </div>
      <div class="capability-grid">
        {
          capabilities.map(([eyebrow, title, body], index) => (
            <article class="capability-card">
              <div class="capability-number">0{index + 1}</div>
              <p>{eyebrow}</p>
              <h3>{title}</h3>
              <span>{body}</span>
            </article>
          ))
        }
      </div>
    </section>

    <section class="home-guide-section" aria-labelledby="developer-guides-title">
      <div class="shell home-guide-inner">
        <div class="home-guide-heading">
          <p class="kicker"><span></span> Developer guides</p>
          <h2 id="developer-guides-title">Evaluate the boundary<br />before you adopt it.</h2>
        </div>
        <div class="home-guide-grid">
          {
            guides.map((guide, index) => (
              <a href={guide.href}>
                <span>0{index + 1}</span>
                <h3>{guide.label}</h3>
                <p>{guide.description}</p>
                <i aria-hidden="true">Read guide →</i>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-fleet-spotlight">
      <div class="shell home-fleet-spotlight-inner">
        <div class="home-fleet-spotlight-copy">
          <p class="kicker light"><span></span> Flagship · RustyAuth Fleet</p>
          <h2>Many realms.<br />One operating view.</h2>
          <p>
            Manage RustyAuth across clouds, projects and customer environments without centralizing their identity
            databases. Fleet coordinates the estate while every realm stays independently authoritative.
          </p>
          <a class="text-link" href="/fleet">Explore the Fleet control plane <span>→</span></a>
        </div>
        <div class="home-fleet-mini-map" role="img" aria-label="RustyAuth Fleet connected to isolated realms across Railway, AWS and customer infrastructure">
          <div class="home-fleet-mini-hub"><small>Management plane</small><strong>RustyAuth Fleet</strong></div>
          <div class="home-fleet-mini-realms">
            <div><span>Railway</span><strong>Product API</strong><small>Private SableDB</small></div>
            <div><span>AWS</span><strong>Customer portal</strong><small>Private SableDB</small></div>
            <div><span>Customer cloud</span><strong>Installed product</strong><small>Private SableDB</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-era-section" id="why-now">
      <div class="shell home-era-inner">
        <div class="home-era-copy">
          <p class="kicker"><span></span> Why now</p>
          <h2>Attacks move faster.<br />Trust should get narrower.</h2>
          <p>
            AI accelerates phishing and automation while software agents create more paths into valuable systems.
            RustyAuth starts by removing reusable human credentials and containing downstream access.
          </p>
        </div>
        <div class="threat-list">
          {
            threatShifts.map(([number, title, body, state]) => (
              <article>
                <span>{number}</span>
                <div><h3>{title}</h3><p>{body}</p></div>
                <strong class={state === "Available now" ? "ready" : "direction"}>{state}</strong>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section shell home-solutions-brief" id="solutions">
      <div class="section-heading">
        <p class="kicker"><span></span> Solutions</p>
        <h2>Start with SaaS.<br />Go where control matters.</h2>
        <p>
          Explore six reference scenarios—from internet-scale products to regulated and disconnected systems—on the
          dedicated Solutions page.
        </p>
      </div>
      <div class="solution-link-grid">
        {
          solutionLinks.map(([label, href], index) => (
            <a href={href}>
              <span>0{index + 1}</span>
              <strong>{label}</strong>
              <i aria-hidden="true">↗</i>
            </a>
          ))
        }
      </div>
    </section>

    <section class="quickstart-section home-quickstart">
      <div class="shell quickstart-grid">
        <div class="quickstart-copy">
          <p class="kicker light"><span></span> Fast path for product teams</p>
          <h2>One launcher.<br />Three clean boundaries.</h2>
          <p>
            The local launcher generates private development secrets and starts the Dioxus dashboard, Rust
            backend and SableDB with the same separation used for deployment.
          </p>
          <a class="text-link" href="/docs/getting-started">Read the complete quickstart <span>→</span></a>
        </div>
        <div class="terminal" aria-label="RustyAuth Docker quickstart">
          <div class="terminal-bar"><span></span><span></span><span></span><small>terminal</small></div>
          <pre><code><b>$</b> git clone https://github.com/<br />&nbsp;&nbsp;rusty-auth/rustyauth.git<br /><br /><b>$</b> cd rustyauth<br /><br /><b>$</b> scripts/local-stack standalone up<br /><br /><i>✓ Dioxus dashboard ready on :8081</i><br /><i>✓ Rust backend and SableDB private</i></code></pre>
        </div>
      </div>

      <div class="shell release-summary">
        <div>
          <p>Honest by default</p>
          <h3>Pre-release, plainly stated.</h3>
        </div>
        <div>
          <span class="ready">Available today</span>
          <p>Passkeys, revocable sessions, ES256 tokens, automatic key rotation, scheduled backups and clean-room restore.</p>
        </div>
        <div>
          <span class="planned">Before 1.0</span>
          <p>Published-image and supported-web qualification, the full Analytics production matrix and canary, witnessed recovery and independent assessments. Native applications remain post-1.0 previews.</p>
        </div>
      </div>
    </section>

    <section class="final-cta final-cta-compact shell">
      <p class="kicker centered"><span></span> Start with the boundary</p>
      <h2>Ship passkey authentication<br />without the identity detour.</h2>
      <p class="final-cta-support">
        Add passkeys without the cost and dependency of another hosted identity platform. Run RustyAuth in
        infrastructure you control.
      </p>
      <div class="hero-actions centered-actions">
        <a class="button button-primary" href="/docs/getting-started">Start locally <span>→</span></a>
        <a class="button button-secondary" href="/solutions">Find your scenario <span>→</span></a>
      </div>
      <p class="final-release-note">
        The solution stories are illustrative—not customer case studies or compliance claims.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-hero-carousel]");

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const tabs = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-tab]"));
    const slidesRegion = carousel.querySelector<HTMLElement>("[data-carousel-slides]");
    const toggle = carousel.querySelector<HTMLButtonElement>("[data-carousel-toggle]");
    const toggleIcon = carousel.querySelector<HTMLElement>("[data-carousel-toggle-icon]");
    const toggleLabel = carousel.querySelector<HTMLElement>("[data-carousel-toggle-label]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const rotationDelay = 6500;
    let activeIndex = 0;
    let rotationTimer: number | undefined;
    let userPaused = reducedMotion;
    let interactionPaused = false;

    const isPaused = () => userPaused || interactionPaused || document.hidden;

    const updateToggle = () => {
      if (!toggle || !toggleIcon || !toggleLabel) return;
      const label = userPaused ? "Resume rotating headlines" : "Pause rotating headlines";
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("aria-pressed", String(userPaused));
      toggleIcon.textContent = userPaused ? "▶" : "Ⅱ";
      toggleLabel.textContent = label;
    };

    const scheduleRotation = () => {
      window.clearTimeout(rotationTimer);
      carousel.classList.toggle("is-paused", isPaused());
      slidesRegion?.setAttribute("aria-live", userPaused ? "polite" : "off");
      updateToggle();

      if (!isPaused()) {
        rotationTimer = window.setTimeout(() => {
          activateSlide((activeIndex + 1) % slides.length);
        }, rotationDelay);
      }
    };

    const activateSlide = (nextIndex: number) => {
      activeIndex = nextIndex;
      slides.forEach((slide, index) => {
        const active = index === activeIndex;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", String(!active));
      });
      tabs.forEach((tab, index) => {
        const active = index === activeIndex;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-pressed", String(active));
      });
      scheduleRotation();
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const nextIndex = Number(tab.dataset.slideIndex);
        if (Number.isInteger(nextIndex)) activateSlide(nextIndex);
      });
    });

    toggle?.addEventListener("click", () => {
      userPaused = !userPaused;
      scheduleRotation();
    });

    carousel.addEventListener("pointerenter", () => {
      interactionPaused = true;
      scheduleRotation();
    });
    carousel.addEventListener("pointerleave", () => {
      interactionPaused = false;
      scheduleRotation();
    });
    carousel.addEventListener("focusin", () => {
      interactionPaused = true;
      scheduleRotation();
    });
    carousel.addEventListener("focusout", () => {
      window.requestAnimationFrame(() => {
        interactionPaused = carousel.contains(document.activeElement);
        scheduleRotation();
      });
    });
    document.addEventListener("visibilitychange", scheduleRotation);

    if (reducedMotion) carousel.dataset.reducedMotion = "true";
    scheduleRotation();
  }
</script>
