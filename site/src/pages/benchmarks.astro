---
import catalogue from "../../../benchmarks/catalog.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/benchmarks.css";

const realmProgram = catalogue.programs.find((program) => program.id === "single-realm-capacity");
if (!realmProgram) throw new Error("single-realm-capacity benchmark programme is missing");

const number = new Intl.NumberFormat("en-GB");
const whole = new Intl.NumberFormat("en-GB", { maximumFractionDigits: 0 });
const updated = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(catalogue.updatedAt));

const realmReports = catalogue.reports.filter((report) => report.programId === realmProgram.id);
const supportedReport = realmReports
  .filter((report) => report.status === "passed")
  .sort((left, right) => right.observedAt.localeCompare(left.observedAt))[0];
const enterpriseReport = realmReports
  .filter((report) => report.methodologyVersion === "single-realm-enterprise-v2")
  .sort((left, right) => right.observedAt.localeCompare(left.observedAt))[0];
if (!supportedReport || !enterpriseReport) throw new Error("single-realm benchmark reports are missing");

const reportResult = (report: typeof supportedReport, key: string) =>
  report.results.find((item) => item.key === key)?.value ?? 0;
const supported = (key: string) => reportResult(supportedReport, key);
const enterprise = (key: string) => reportResult(enterpriseReport, key);

const supportedOperatingRps = Math.floor(supported("sustainable_authenticated_rps") * 0.7);
const supportedTypicalUsers = supported("supported_typical_active_users");
const candidateBoundaryRps = enterprise("sustainable_authenticated_rps");
const candidateOperatingRps = enterprise("candidate_operating_rps");
const candidateTypicalUsers = enterprise("candidate_typical_active_users");
const firstFailingRps = enterprise("first_failing_rps");
const latencyP95 = enterprise("mixed_authenticated_p95_ms");
const unplanned5xx = enterprise("unplanned_5xx");
const mixedRequests = enterpriseReport.dataset.find((item) => item.key === "mixed_requests_at_qualified_boundary")
  ?.value ?? 0;

const boundaryChart = enterpriseReport.charts?.find((chart) => chart.id === "mixed-boundary-latency");
if (!boundaryChart) throw new Error("mixed-boundary-latency chart is missing");
const chartData = {
  labels: boundaryChart.series[0].points.map((point) => `${number.format(point.x)} RPS`),
  datasets: boundaryChart.series.map((series, index) => ({
    label: series.name,
    data: series.points.map((point) => point.y),
    borderColor: ["#e56a25", "#f0b06f", "#73b9ae", "#aaa39c"][index],
    backgroundColor: ["#e56a25", "#f0b06f", "#73b9ae", "#aaa39c"][index],
  })),
};
const workloadChart = {
  labels: realmProgram.enterpriseProfile?.mix.map((item) => item.operation) ?? [],
  values: realmProgram.enterpriseProfile?.mix.map((item) => item.percent) ?? [],
};

const timingLenses = [
  ["End-to-end", latencyP95, "Public Railway edge"],
  ["Application", enterprise("application_p95_ms"), "Includes datastore work"],
  ["SableDB", enterprise("sable_p95_ms"), "Accumulated datastore time"],
  ["External path", enterprise("external_path_p95_ms"), "Runner, edge and network"],
] as const;

const competitorContext = [
  {
    provider: "RustyAuth 1.0",
    signal: `${number.format(candidateBoundaryRps)} mixed RPS at ${whole.format(latencyP95)} ms p95`,
    shape: enterpriseReport.environment,
    reading: "Measured here. Candidate operating capacity still needs a fresh one-hour soak and recovery.",
    url: enterpriseReport.evidence[0]?.url ?? "/benchmarks/catalog.json",
  },
  {
    provider: "Keycloak",
    signal: "Regularly tested at 300 RPS / 1,000,000 users",
    shape: "Three pods plus a multi-AZ Aurora reference architecture",
    reading: "Stronger large-dataset and HA evidence; a different workload and much larger topology.",
    url: "https://www.keycloak.org/high-availability/single-cluster/introduction",
  },
  {
    provider: "Rauthy",
    signal: "35–65 MB published small-deployment footprint",
    shape: "Embedded Hiqlite or PostgreSQL",
    reading: "Promising footprint, but no reproducible like-for-like public RPS run.",
    url: "https://github.com/sebadob/rauthy#fast-and-efficient",
  },
  {
    provider: "Clerk",
    signal: "Production Backend API limit: 1,000 requests / 10 seconds",
    shape: "Managed multi-tenant service",
    reading: "A service limit, not a benchmark; browser auth and local token checks differ.",
    url: "https://clerk.com/docs/guides/how-clerk-works/system-limits",
  },
  {
    provider: "Auth0",
    signal: "Private Cloud tiers: 100–10,000 RPS",
    shape: "Managed public or dedicated private cloud",
    reading: "A contracted rate envelope without a matching public workload or latency trace.",
    url: "https://auth0.com/docs/deploy-monitor/deploy-private-cloud/private-cloud-on-aws",
  },
];
---

<BaseLayout
  title="RustyAuth Benchmarks — Single-Realm Capacity and Latency"
  description="Reproducible RustyAuth single-realm capacity, latency and scale evidence with an interactive planning model and retained raw results."
  structuredData={{
    "@type": "Dataset",
    "@id": "https://rustyauth.dev/benchmarks/#dataset",
    name: "RustyAuth benchmark catalogue",
    description: "Versioned performance evidence for RustyAuth realms and Fleet Analytics.",
    url: "https://rustyauth.dev/benchmarks/",
    distribution: {
      "@type": "DataDownload",
      contentUrl: "https://rustyauth.dev/benchmarks/catalog.json",
      encodingFormat: "application/json",
    },
    creator: { "@id": "https://rustyauth.dev/#organization" },
  }}
>
  <main class="benchmark-story">
    <section class="benchmark-hero shell">
      <div class="benchmark-hero-copy">
        <p class="benchmark-kicker"><span></span> Reproducible performance evidence</p>
        <h1>One realm.<br /><em>{number.format(candidateBoundaryRps)} mixed RPS.</em></h1>
        <p class="benchmark-lede">
          <strong>{whole.format(latencyP95)} ms p95</strong> through Railway’s public edge,<br />
          with <strong>zero unplanned server 5xx</strong> at the retained boundary.
        </p>
        <div class="benchmark-actions">
          <a class="primary" href="#proof">Explore the evidence <span>→</span></a>
          <a href="/benchmarks/catalog.json">Download data <span>↓</span></a>
        </div>
      </div>

      <aside class="benchmark-run-facts" aria-label="Current single-realm benchmark facts">
        <dl>
          <div><dt>Workload</dt><dd>Active baseline · Single-realm Railway</dd></div>
          <div><dt>Candidate typical active users</dt><dd>{number.format(candidateTypicalUsers)}</dd></div>
          <div><dt>Supported typical active users</dt><dd>{number.format(supportedTypicalUsers)}</dd></div>
          <div><dt>First tested bend</dt><dd>{number.format(firstFailingRps)} RPS</dd></div>
          <div><dt>Methodology</dt><dd>Version 2 · {realmReports.length} runs</dd></div>
          <div><dt>Catalogue updated</dt><dd>{updated}</dd></div>
        </dl>
        <p class="benchmark-status-key">
          <span class="published">Published baseline</span><span class="candidate">Candidate</span><span>Next test</span>
        </p>
      </aside>
    </section>

    <section class="benchmark-curve" aria-labelledby="curve-title">
      <div class="shell">
        <header>
          <div>
            <p>Measured boundary curve · lower is better</p>
            <h2 id="curve-title">{boundaryChart.title}</h2>
          </div>
          <p class="benchmark-chart-note">Exact two-minute public Railway windows. Lines are separate timing lenses and are not additive.</p>
        </header>
        <div class="benchmark-chart-wrap">
          <canvas
            id="benchmark-latency-chart"
            data-chart={JSON.stringify(chartData)}
            aria-label="Latency at 2,400 and 3,200 mixed authenticated requests per second"
          ></canvas>
        </div>
      </div>
    </section>

    <section class="benchmark-spectrum shell" aria-labelledby="spectrum-title">
      <h2 id="spectrum-title">Capacity spectrum <span>single realm</span></h2>
      <div class="benchmark-spectrum-grid">
        <article class="supported">
          <span>Supported planning</span><strong>{number.format(supportedOperatingRps)} RPS</strong>
          <p>{number.format(supportedTypicalUsers)} typical active users</p><small>Published production planning</small>
        </article>
        <article class="candidate">
          <span>Retained candidate signal</span><strong>{number.format(candidateOperatingRps)} RPS</strong>
          <p>{number.format(candidateTypicalUsers)} typical active users</p><small>Observed short-window headroom rate</small>
        </article>
        <article class="bend">
          <span>First tested bend</span><strong>{number.format(firstFailingRps)} RPS</strong>
          <p>{whole.format(boundaryChart.series[0].points[1].y)} ms end-to-end p95</p><small>Not a planning target</small>
        </article>
        <p class="benchmark-spectrum-reading">Supported is what we plan for. Candidate is what the retained boundary suggests. Bend is where the strict gates first stop passing.</p>
      </div>
    </section>

    <section class="benchmark-sizer shell" aria-labelledby="sizer-title">
      <header>
        <div><h2 id="sizer-title">Size your realm</h2><p>Planning model for simultaneously active users—not stored accounts or MAU.</p></div>
        <p><strong>Assumption</strong> Six authenticated requests per active user per minute</p>
      </header>
      <div class="benchmark-sizer-body">
        <div class="benchmark-scenarios" role="group" aria-label="Choose an active audience size">
          <span>Choose active audience</span>
          <button type="button" data-active-users="10000" aria-pressed="true"><strong>10k active</strong><small>Product team</small></button>
          <button type="button" data-active-users="50000" aria-pressed="false"><strong>50k active</strong><small>Large product</small></button>
          <button type="button" data-active-users="100000" aria-pressed="false"><strong>100k active</strong><small>Enterprise scale</small></button>
        </div>
        <div class="benchmark-sizing-output" aria-live="polite">
          <p><span>Simultaneously active</span><strong data-sizing-users>10,000</strong><small>users</small></p>
          <p><span>Request demand</span><strong data-sizing-rps>1,000</strong><small>RPS at six requests/minute</small></p>
          <p><span>Supported planning</span><strong data-sizing-supported>2</strong><small>independent realm cells</small></p>
          <p><span>Candidate model</span><strong data-sizing-candidate>1</strong><small>realm cell · not Fleet proof</small></p>
        </div>
      </div>
      <footer>Stored-account limits, redundancy, Fleet coordination, global routing and regional recovery require separate qualification.</footer>
    </section>

    <section class="benchmark-proof shell" id="proof" aria-labelledby="proof-title">
      <header>
        <div><p>Retained run · {number.format(mixedRequests)} measured requests</p><h2 id="proof-title">The proof</h2></div>
        <p>Public-edge Railway. Mixed workload. Zero unplanned 5xx at the {number.format(candidateBoundaryRps)} RPS boundary.</p>
      </header>
      <div class="benchmark-proof-grid">
        <article class="benchmark-timings">
          <h3>Latency lenses <span>p95 · not additive</span></h3>
          <dl>
            {timingLenses.map(([label, value, note]) => (
              <div><dt>{label}<small>{note}</small></dt><dd>{whole.format(value)} ms</dd></div>
            ))}
          </dl>
        </article>
        <article class="benchmark-boundary-result">
          <h3>Boundary result <span>{number.format(candidateBoundaryRps)} RPS</span></h3>
          <dl>
            <div><dt>End-to-end p95</dt><dd>{whole.format(latencyP95)} ms</dd></div>
            <div><dt>Unexpected failure rate</dt><dd>{enterprise("qualified_boundary_failure_percent").toFixed(3)}%</dd></div>
            <div><dt>Unplanned 5xx</dt><dd>{whole.format(unplanned5xx)}</dd></div>
            <div><dt>Passkey ceremony p95 under load</dt><dd>{whole.format(enterprise("signin_p95_ms"))} ms</dd></div>
          </dl>
        </article>
        <article class="benchmark-mix">
          <h3>Workload mix <span>High-traffic product journey v2</span></h3>
          <div class="benchmark-mix-content">
            <div class="benchmark-mix-chart">
              <canvas id="benchmark-workload-chart" data-chart={JSON.stringify(workloadChart)} aria-label="Benchmark workload mix"></canvas>
            </div>
            <ul>{workloadChart.labels.map((label, index) => <li><span>{label}</span><strong>{workloadChart.values[index]}%</strong></li>)}</ul>
          </div>
        </article>
      </div>
    </section>

    <section class="benchmark-evidence shell" aria-label="Benchmark evidence and context">
      <details>
        <summary><strong>Methodology</strong><span>Dataset, hardware, workload, soak window and boundaries</span><b>+</b></summary>
        <div class="benchmark-detail-copy">
          <p><strong>Environment:</strong> {enterpriseReport.environment}.</p>
          <p><strong>Dataset:</strong> {number.format(enterprise("registered_accounts"))} synthetic accounts and {number.format(enterprise("valid_sessions"))} valid sessions.</p>
          <p><strong>Qualification:</strong> {enterpriseReport.qualification}. The candidate rate is not promoted until a fresh one-hour soak and recovery pass.</p>
        </div>
      </details>

      <details>
        <summary><strong>Raw evidence</strong><span>Reports, reviewed metrics, traces and deployment artefacts</span><b>+</b></summary>
        <div class="benchmark-link-list">
          {enterpriseReport.evidence.map((item) => <a href={item.url}>{item.label}<span>↗</span></a>)}
          <a href="/benchmarks/catalog.json">Machine-readable benchmark catalogue<span>↓</span></a>
        </div>
      </details>

      <details>
        <summary><strong>Cost &amp; operations</strong><span>Measured shape, incomplete soak and what is not included</span><b>+</b></summary>
        <div class="benchmark-detail-grid">
          <p><strong>RustyAuth API</strong><span>1 vCPU / 1 GB ceiling</span></p>
          <p><strong>SableDB</strong><span>4 vCPU / 4 GB ceiling</span></p>
          <p><strong>Monthly run-rate</strong><span>Not claimed from the incomplete soak</span></p>
          <p><strong>Additional</strong><span>Storage, egress, redundancy and operator time</span></p>
        </div>
      </details>

      <details>
        <summary><strong>Publication gates</strong><span>What must pass before a result becomes supported capacity</span><b>+</b></summary>
        <ol class="benchmark-gates">{realmProgram.gates.map((gate) => <li>{gate}</li>)}</ol>
      </details>

      <details open class="benchmark-competitors">
        <summary><strong>Competitor context</strong><span>First-party public signals, with unlike workloads labelled</span><b>−</b></summary>
        <div class="benchmark-comparison" role="table" aria-label="Identity provider performance context">
          <div class="benchmark-comparison-head" role="row">
            <span role="columnheader">Provider</span><span role="columnheader">Public signal</span><span role="columnheader">Reference shape</span><span role="columnheader">How to read it</span>
          </div>
          {competitorContext.map((provider) => (
            <a href={provider.url} role="row">
              <strong role="cell">{provider.provider}</strong>
              <span role="cell"><small>Public signal</small>{provider.signal}</span>
              <span role="cell"><small>Reference shape</small>{provider.shape}</span>
              <span role="cell"><small>How to read it</small>{provider.reading} ↗</span>
            </a>
          ))}
        </div>
      </details>
    </section>

    <section class="benchmark-final shell">
      <div class="benchmark-actions">
        <a class="primary" href={enterpriseReport.evidence[0]?.url}>See the evidence <span>→</span></a>
        <a href="/benchmarks/catalog.json">Download JSON <span>↓</span></a>
      </div>
      <p>Published {updated}<span></span>Active baseline: Single-realm Railway</p>
    </section>
  </main>

  <script>
    import Chart from "chart.js/auto";

    const latencyCanvas = document.querySelector<HTMLCanvasElement>("#benchmark-latency-chart");
    if (latencyCanvas?.dataset.chart) {
      const chart = JSON.parse(latencyCanvas.dataset.chart);
      new Chart(latencyCanvas, {
        type: "line",
        data: chart,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: "index", intersect: false },
          plugins: {
            legend: { labels: { color: "#e5dfd7", usePointStyle: true, boxWidth: 7, boxHeight: 7 } },
            tooltip: { callbacks: { label: (context) => `${context.dataset.label}: ${Math.round(Number(context.raw))} ms` } },
          },
          elements: { line: { borderWidth: 2.5, tension: 0.18 }, point: { radius: 5, hoverRadius: 7 } },
          scales: {
            x: { ticks: { color: "#c9c3bd" }, grid: { color: "rgba(255,255,255,.08)" }, border: { color: "rgba(255,255,255,.2)" } },
            y: { beginAtZero: true, suggestedMax: 350, ticks: { color: "#c9c3bd", callback: (value) => `${value} ms` }, grid: { color: "rgba(255,255,255,.11)" }, border: { display: false } },
          },
        },
      });
    }

    const workloadCanvas = document.querySelector<HTMLCanvasElement>("#benchmark-workload-chart");
    if (workloadCanvas?.dataset.chart) {
      const chart = JSON.parse(workloadCanvas.dataset.chart);
      new Chart(workloadCanvas, {
        type: "doughnut",
        data: {
          labels: chart.labels,
          datasets: [{ data: chart.values, backgroundColor: ["#cc5a19", "#e58928", "#e5b976", "#77716b"], borderColor: "#fffaf2", borderWidth: 2 }],
        },
        options: { responsive: true, maintainAspectRatio: false, resizeDelay: 50, cutout: "58%", plugins: { legend: { display: false } } },
      });
    }

    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-active-users]")];
    const usersOutput = document.querySelector<HTMLElement>("[data-sizing-users]");
    const rpsOutput = document.querySelector<HTMLElement>("[data-sizing-rps]");
    const supportedOutput = document.querySelector<HTMLElement>("[data-sizing-supported]");
    const candidateOutput = document.querySelector<HTMLElement>("[data-sizing-candidate]");
    const formatter = new Intl.NumberFormat("en-GB");
    const supportedUsers = Number("5600");
    const candidateUsers = Number("16800");
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const activeUsers = Number(button.dataset.activeUsers ?? 0);
        for (const item of buttons) item.setAttribute("aria-pressed", String(item === button));
        if (usersOutput) usersOutput.textContent = formatter.format(activeUsers);
        if (rpsOutput) rpsOutput.textContent = formatter.format(Math.ceil(activeUsers / 10));
        if (supportedOutput) supportedOutput.textContent = formatter.format(Math.ceil(activeUsers / supportedUsers));
        if (candidateOutput) candidateOutput.textContent = formatter.format(Math.ceil(activeUsers / candidateUsers));
      });
    }

    for (const details of document.querySelectorAll<HTMLDetailsElement>(".benchmark-evidence details")) {
      details.addEventListener("toggle", () => {
        const indicator = details.querySelector("summary b");
        if (indicator) indicator.textContent = details.open ? "−" : "+";
      });
    }
  </script>
</BaseLayout>
