import DocsLayout from "../../layouts/DocsLayout.astro";
const endpoints = [
  ["GET", "/healthz", "Public", "Process liveness"],
  ["GET", "/readyz", "Public", "Private datastore readiness"],
  ["GET", "/.well-known/jwks.json", "Public", "ES256 verification keys"],
  ["POST", "/v1/passkeys/registration/options", "Origin + bootstrap", "Start first registration"],
  ["POST", "/v1/passkeys/registration/verify", "Origin + bootstrap", "Finish first registration"],
  ["POST", "/v1/passkeys/authentication/options", "Origin", "Start sign-in"],
  ["POST", "/v1/passkeys/authentication/verify", "Origin", "Finish sign-in"],
  ["POST", "/v1/token", "Session + origin", "Mint short-lived JWT"],
  ["GET", "/v1/account", "Session + origin", "Read identity profile"],
