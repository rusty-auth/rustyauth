# Loopback development values only. Copy this file to an untracked .env.
# AUTH_ENV is required and has no default; the process refuses to start without it.
AUTH_ENV=development
# Reverse proxies in front of this service. Required in production; set it to 1 when the
# platform terminates TLS. Zero here because the compose stack reaches the process directly,
# so the TCP peer really is the client and X-Forwarded-For must not be trusted.
AUTH_TRUSTED_PROXY_HOPS=0
AUTH_ISSUER=http://localhost:8081
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8081
WEBAUTHN_RP_NAME=RustyAuth Local
SABLEDB_URL=redis://sabledb:6379
# Every secret below is intentionally blank. A committed value is a public value, and
# the entropy check in src/config.rs cannot distinguish a generated key from one that
# has been published — so the service refuses a blank rather than shipping a default
# that looks generated. Fill these in after copying this file to .env:
#
#   printf 'AUTH_MASTER_KEY_HEX=%s\n'      "$(openssl rand -hex 32)"    >> .env
#   printf 'BOOTSTRAP_TOKEN=%s\n'          "$(openssl rand -base64 48)" >> .env
#   printf 'AUTH_EVENT_RPC_TOKEN=%s\n'     "$(openssl rand -base64 48)" >> .env
#   printf 'AUTH_IDENTITY_RPC_TOKEN=%s\n'  "$(openssl rand -base64 48)" >> .env
#
# Generate each independently; the three tokens must differ from each other.
AUTH_MASTER_KEY_HEX=
# During master-key rotation, put comma-separated old keys here until every instance has rewrapped.
AUTH_MASTER_PREVIOUS_KEYS_HEX=
BOOTSTRAP_TOKEN=
# Private RPC bearer credentials. Use distinct random values in every environment.
AUTH_EVENT_RPC_TOKEN=
AUTH_IDENTITY_RPC_TOKEN=
# Passkey users whose canonical email may bootstrap an owner operator record.
AUTH_OPERATOR_EMAILS=admin@rustyauth.local
SPACETIME_AUDIENCE=vtr-dashboard-v2-local
AUTH_TENANT_ID=vtr
AUTH_REALM_ID=realm-local
AUTH_ACCESS_TOKEN_SECONDS=300
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=604800
AUTH_SIGNING_KEY_ROTATION_SECONDS=2592000
AUTH_SIGNING_KEY_PREPUBLISH_SECONDS=600
AUTH_SIGNING_KEY_OVERLAP_SECONDS=600
AUTH_KEY_MAINTENANCE_SECONDS=30

# Supply all six required backup values or none. When present, backups run immediately and every
# AUTH_BACKUP_INTERVAL_SECONDS thereafter.
AUTH_BACKUP_ENDPOINT=
AUTH_BACKUP_REGION=
AUTH_BACKUP_BUCKET=
AUTH_BACKUP_ACCESS_KEY_ID=
AUTH_BACKUP_SECRET_ACCESS_KEY=
AUTH_BACKUP_ENCRYPTION_KEY_HEX=
# Keep old keys here, comma-separated, until the snapshots they protect have expired.
AUTH_BACKUP_PREVIOUS_KEYS_HEX=
AUTH_BACKUP_INTERVAL_SECONDS=21600
AUTH_BACKUP_URL_STYLE=virtual

PORT=8080
RUST_LOG=rustyauth=info,tower_http=info
