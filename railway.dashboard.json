{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.dashboard"
  },
  "deploy": {
    "numReplicas": 1,
    "overlapSeconds": 10,
    "drainingSeconds": 10,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
