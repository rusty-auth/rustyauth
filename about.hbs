<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>RustyAuth third-party licences</title>
  <style>
    body { max-width: 72rem; margin: 2rem auto; padding: 0 1rem; font: 16px/1.5 system-ui, sans-serif; color: #2f2f2f; }
    h1, h2 { line-height: 1.2; }
    a { color: #a94612; }
    pre { overflow: auto; padding: 1rem; background: #f6f3ee; border: 1px solid #ddd6ca; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>RustyAuth third-party licences</h1>
  <p>Generated from the locked Cargo dependency graph with <code>cargo-about</code>. RustyAuth itself is licensed under Apache-2.0.</p>
  {{#each licenses}}
    <section>
      <h2 id="{{id}}">{{name}}</h2>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
          <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    </section>
  {{/each}}
</body>
</html>
