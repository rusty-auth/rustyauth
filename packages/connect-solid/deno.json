{
  "name": "@rustyauth/connect-solid",
  "version": "0.1.0",
  "description": "ConnectRPC v2 transport and Solid Query option factories for RustyAuth",
  "license": "MIT",
  "repository": "https://github.com/rusty-auth/rustyauth",
  "exports": {
    ".": "./src/index.ts"
  },
  "publish": {
    "include": ["src/**/*.ts", "README.md", "LICENSE", "deno.json"],
    "exclude": ["**/*_test.ts"]
  },
  "tasks": {
    "check": "deno check src/index.ts",
    "test": "deno test",
    "publish:dry": "deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@connectrpc/connect": "npm:@connectrpc/connect@^2.0.0",
    "@connectrpc/connect-web": "npm:@connectrpc/connect-web@^2.0.0"
  }
}
