{
  "name": "@rustyauth/client",
  "version": "0.1.0",
  "description": "Framework-agnostic browser client for the RustyAuth public passkey HTTP API",
  "license": "Apache-2.0",
  "repository": "https://github.com/rusty-auth/rustyauth",
  "exports": {
    ".": "./src/index.ts"
  },
  "publish": {
    "include": ["src/**/*.ts", "README.md", "LICENSE", "deno.json"],
    "exclude": ["**/*_test.ts"]
  },
  "tasks": {
    "check": "deno check src/index.ts",
    "test": "deno test",
    "publish:dry": "deno publish --dry-run --allow-dirty"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"]
  }
}
